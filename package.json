{
  "name": "@quixomatic/ui-renderer-react-simple",
  "version": "2.1.1",
  "description": "React 19 for ServiceNow Next Experience components: a ui-core renderer with React 19 bundled in, plus setup and CLI patching",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "setup-servicenow-react": "scripts/setup.cjs",
    "patch-servicenow-babel": "scripts/patch-babel.cjs",
    "restore-servicenow-babel": "scripts/restore-babel.cjs",
    "servicenow-shadcn-fix": "scripts/shadcn-fix.cjs"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "INSTALLATION.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "servicenow",
    "react",
    "renderer",
    "ui-framework",
    "next-experience",
    "react-19",
    "babel",
    "jsx"
  ],
  "author": "Quixomatic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quixomatic/ui-renderer-react-simple.git"
  },
  "bugs": {
    "url": "https://github.com/Quixomatic/ui-renderer-react-simple/issues"
  },
  "homepage": "https://github.com/Quixomatic/ui-renderer-react-simple#readme"
}
